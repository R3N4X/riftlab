# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.local.example

# estado del agregador
/data/crawl-state.json

# app de escritorio (compilada)
/desktop/dist
/dist-installer

# configuración local de las herramientas
/.claude

# datos generados: se arman con npm run aggregate (el índice de jugadores tiene Riot ID de terceros)
/data/

# archivos de compilación del instalador
/build/

# intermediario de Cloudflare: dependencias, estado local y secretos de prueba
/intermediario/node_modules
/intermediario/.wrangler
/intermediario/.dev.vars

# resultados locales del QA automático (no se publican)
/qa/
