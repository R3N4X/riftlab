{
  "name": "riftlab",
  "version": "0.2.16",
  "private": true,
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "desktop:compile": "esbuild desktop/main.ts desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=desktop/dist --out-extension:.js=.cjs --log-level=warning",
    "desktop:dev": "npm run desktop:compile && electron .",
    "desktop:build": "next build && tsx scripts/prepare-standalone.ts && npm run desktop:compile",
    "desktop": "npm run desktop:build && electron . --prod",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "aggregate": "tsx scripts/aggregate.ts",
    "aggregate:tft": "tsx scripts/aggregate-tft.ts",
    "sync:positions": "tsx scripts/sync-positions.ts",
    "typecheck": "tsc --noEmit",
    "dist": "npm run desktop:build && tsx scripts/stage-installer.ts && electron-builder --win nsis --publish never",
    "release": "npm run dist && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publicar-version.ps1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-updater": "6.8.10",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.0.0",
    "electron-builder": "26.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "RiftLab: estadÃƒÂ­sticas de League of Legends y TFT",
  "author": "RiftLab",
  "build": {
    "appId": "com.riftlab.app",
    "productName": "RiftLab",
    "directories": {
      "output": "dist-installer",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build/server",
        "to": "server",
        "filter": [
          "**/*",
          ".next/**/*"
        ]
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "meta.json",
          "tft-meta.json",
          "patches/*.json"
        ]
      },
      {
        "from": "build/proxy.json",
        "to": "proxy.json"
      },
      {
        "from": "desktop/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "RiftLab-Setup-${version}.${ext}",
      "shortcutName": "RiftLab",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "R3N4X",
        "repo": "riftlab",
        "releaseType": "release"
      }
    ]
  }
}
